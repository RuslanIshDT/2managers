# Модель. Один модуль, адрес меняется без правки кода.
# Kodik Router: LLM_BASE_URL=https://api.kodikrouter.ru/v1 и свой ключ. Пустой ключ — вызовов нет.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# Langfuse этого проекта. Пустые ключи — разбор идёт, трассировка молчит.
# HOST — адрес из контейнера. PROJECT_URL — ссылка для браузера, без ключей.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_URL=
# Telegram-бот руководителя
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Адрес стенда для ссылок в сообщениях и подстановки {{origin}} в форме
STAND_ORIGIN=
# Вход руководителя на стенде. Пароль задаёт владелец, в репозиторий не писать.
LEADER_LOGIN=ivan
LEADER_PASSWORD=
# Пароль входа для каталога data/leader2. Пусто — второй руководитель на стенд не попадает. Логин лежит в файле каталога.
LEADER2_PASSWORD=
LEADER_LINK_CODE=
# База. В Compose DATABASE_URL собирается сам, снаружи нужен POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
# Порты стенда. PUBLIC_BIND — адрес, на котором слушает HTTPS. По умолчанию только localhost.
HTTP_PORT=8090
HTTPS_PORT=8443
PUBLIC_BIND=127.0.0.1
STAND_HOST=localhost
# Каталог с site.crt и site.key. В репозиторий сертификаты не класть.
TLS_DIR=
# Яндекс Почта. Пусто — почта не настроена, отправка не имитируется.
YANDEX_MAIL_USER=
YANDEX_MAIL_PASSWORD=
# Календарь Яндекса: пароль приложения типа «Календарь», не пароль почты. Пусто — календарь не подключён.
YANDEX_CALENDAR_PASSWORD=
# Трекер Яндекса. Пусто — задачи остаются только в базе стенда.
YANDEX_TRACKER_TOKEN=
YANDEX_TRACKER_ORG=
YANDEX_TRACKER_QUEUE=
# Секрет вебхука Telegram. Пока пусто, адрес вебхука не отвечает.
TELEGRAM_WEBHOOK_SECRET=
