{
  "name": "2managers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "vite build",
    "start": "node src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "flow-audit": "node --env-file=.env src/scripts/flow-audit.ts",
    "flow-audit:dry": "node src/scripts/flow-audit.ts --dry-run",
    "audit:telegram": "node --env-file=.env src/scripts/audit-telegram.ts",
    "audit:telegram:dry": "node --env-file=.env src/scripts/audit-telegram.ts --dry-run",
    "tg:chats": "node --env-file=.env src/scripts/audit-telegram.ts --chats",
    "requests": "node --env-file=.env src/scripts/requests.ts",
    "reset-stand": "node src/scripts/reset-stand.ts",
    "remove-leader": "node --env-file-if-exists=.env src/scripts/remove-leader.ts",
    "sync-materials": "node src/scripts/sync-materials.ts",
    "e2e": "playwright test",
    "eval": "node --env-file-if-exists=.env src/scripts/eval.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "8.3.0",
    "drizzle-orm": "0.44.7",
    "fastify": "5.6.2",
    "imapflow": "1.0.193",
    "nodemailer": "7.0.11",
    "pg": "8.16.3",
    "pg-boss": "10.3.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@radix-ui/react-slot": "1.2.4",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
